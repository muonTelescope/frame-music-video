{
  "name": "frame-music-video",
  "version": "1.0.0",
  "description": "Cosmic Rain — an animated synthwave assembly music video for the muonTelescope frame",
  "scripts": {
    "cues": "node tools/export-cues.mjs",
    "audio": "python3 audio/compose.py",
    "stills": "node render.mjs --stills",
    "video": "node render.mjs",
    "build": "npm run cues && npm run audio && npm run video"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muonTelescope/frame-music-video.git"
  },
  "bugs": {
    "url": "https://github.com/muonTelescope/frame-music-video/issues"
  },
  "homepage": "https://github.com/muonTelescope/frame-music-video#readme",
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "playwright-core": "1.56",
    "three": "^0.186.1"
  },
  "type": "module",
  "private": true
}
